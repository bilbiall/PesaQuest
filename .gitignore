# Local backup/deployment archives — snapshots taken between cPanel deploys,
# not source code. Several are individually under GitHub's 100MB hard limit
# but collectively hundreds of MB, and none of them belong in version control.
*.zip
/A-pesaquestversions made/

# Claude Code's own local session/tool config — not part of the application.
/.claude/

# Local dev database artifact (the project uses MySQL; this is just a leftover
# from Laravel's default post-create-project script).
/database/database.sqlite

# User-uploaded content (profile photos etc.) — real user data, not source code.
/public/uploads/*
!public/uploads/.gitkeep
